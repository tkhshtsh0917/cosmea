include LICENSE README.md README.ja.md NOTICE.md CONTRIBUTING.md CONTRIBUTING.ja.md AGENTS.md
include mise.toml .python-version mkdocs.yml
include uv.lock
recursive-include docs *.md *.css
recursive-include examples *.py *.md
recursive-include experiments *.py
recursive-include tests *.py
recursive-include scripts *.py
include scripts/api_reference.md
recursive-include scripts/mkdocs_theme *.html
prune .private
prune .venv
